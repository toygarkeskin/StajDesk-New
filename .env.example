# StajDesk ortam değişkenleri (docker compose).
#
# Önerilen: rastgele, güçlü değerlerle otomatik oluşturun:
#   node scripts/setup-secrets.mjs
# Elle kopyalarsanız (cp .env.example .env) CHANGE_ME değerlerinin tamamını değiştiriniz.
# .env depoya girmez (.gitignore). Gerçek parola veya anahtarı bu dosyaya (.env.example) yazmayınız.

POSTGRES_DB=stajdesk
POSTGRES_USER=stajdesk
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_USER=stajdesk
RABBITMQ_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# JWT imzalama anahtarı: en az 32 karakter, rastgele
JWT_KEY=CHANGE_ME
# Demo hesaplarının başlangıç parolası (yalnızca boş veritabanı ilk kez doldurulurken kullanılır).
# Politika: en az 10 karakter, büyük harf, küçük harf ve rakam.
SEED_DEFAULT_PASSWORD=CHANGE_ME

# E-posta (SMTP). Varsayılan: compose içindeki Mailpit (http://localhost:8126) — dışarıya e-posta gitmez.
# Gerçek sunucu için Host/Port/User/Password değerlerini değiştiriniz.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Giriş ekranında "test posta kutusunu aç" bağlantısı (yalnızca geliştirme; üretimde boş bırakınız)
DEV_MAILBOX_URL=http://localhost:8126

# Yalnızca canlı ortam katmanı (docker-compose.prod.yml) için. Ayrıntı: docs/guides/deployment.md
# DOMAIN=portal.sirket.com
# ACME_EMAIL=bt@sirket.com
